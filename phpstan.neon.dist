parameters:
    level: 5
    paths:
        - controllers
        - models
        - services
        - repositories
        - helpers
        - enum
        - widgets
    excludePaths:
        - models/providers/*
    bootstrapFiles:
        - phpstan-bootstrap.php
    scanDirectories:
        - vendor/yiisoft/yii2
    tmpDir: .phpstan-cache
    dynamicConstantNames:
        - YII_ENV
        - YII_ENV_DEV
        - YII_ENV_PROD
        - YII_ENV_TEST
